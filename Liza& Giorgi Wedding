<!DOCTYPE html>
<html lang="ka">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ლიზა & გიორგი - საქორწილო მოსაწვევი</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts for Georgian typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Noto+Serif+Georgian:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Noto Serif Georgian', serif;
            background-color: #fcf9f2;
            color: #4a4238;
            overflow-x: hidden;
        }
        .font-header {
            font-family: 'Marcellus', 'Noto Serif Georgian', serif;
        }
        /* Open Animation */
        .envelope-container {
            transition: transform 1.2s cubic-bezier(0.77, 0, 0.175, 1), opacity 1s ease-in-out;
        }
        .envelope-open {
            transform: translateY(-100%);
            opacity: 0;
            pointer-events: none;
        }
        /* Floating Petals Animation */
        @keyframes floatPetal {
            0% {
                transform: translateY(-10vh) rotate(0deg);
                opacity: 0.8;
            }
            100% {
                transform: translateY(110vh) rotate(360deg);
                opacity: 0.2;
            }
        }
        .petal {
            position: fixed;
            top: -10%;
            pointer-events: none;
            z-index: 10;
            animation: floatPetal linear infinite;
        }
    </style>
</head>
<body class="relative min-h-screen flex justify-center items-center p-0 m-0">

    <!-- Background Music -->
    <audio id="weddingMusic" loop preload="auto">
        <source src="https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3" type="audio/mpeg">
    </audio>

    <!-- Floating Audio Control Button -->
    <button id="musicToggle" onclick="toggleAudio()" class="fixed top-5 right-5 z-40 bg-white/80 backdrop-blur-md p-3 rounded-full shadow-lg border border-[#e5dcd0] text-[#7a6b58] hover:bg-white transition">
        <svg id="musicIconPlay" class="w-6 h-6 hidden" fill="currentColor" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z"/>
        </svg>
        <svg id="musicIconMute" class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M4.27 3L3 4.27l4.66 4.66H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/>
        </svg>
    </button>

    <!-- Floating Petals Container -->
    <div id="petalsContainer"></div>

    <!-- Interactive Envelope Gate Cover -->
    <div id="envelope" class="envelope-container fixed inset-0 z-50 bg-[#f7f2ea] flex flex-col justify-center items-center p-6 text-center shadow-2xl border-8 border-[#f0e6d8]">
        <div class="max-w-md w-full flex flex-col items-center">
            <div class="w-24 h-24 mb-6 rounded-full border border-[#d8c3a5] p-1 flex items-center justify-center">
                <div class="w-full h-full rounded-full border-2 border-[#b89f7d] flex items-center justify-center bg-[#faf6f0]">
                    <span class="font-header text-2xl text-[#8c7355] font-bold">L & G</span>
                </div>
            </div>
            <h2 class="text-xl text-[#7a6b58] mb-2 font-light">საქორწილო მოსაწვევი</h2>
            <p class="text-sm text-[#a0907e] mb-10 tracking-widest uppercase">ლიზა & გიორგი</p>
            
            <!-- Wax Seal Open Button -->
            <button onclick="openInvitation()" class="relative group focus:outline-none">
                <div class="w-20 h-20 bg-[#c49a6c] rounded-full shadow-xl flex items-center justify-center transform group-hover:scale-105 transition-all duration-300 border-4 border-[#e8d5bf]">
                    <span class="font-header text-[#ffffff] text-lg tracking-wider font-semibold">გახსნა</span>
                </div>
            </button>
            <p class="text-xs text-[#a0907e] mt-6 tracking-wider">დააჭირეთ ბეჭედს მოსაწვევის სანახავად</p>
        </div>
    </div>

    <!-- Main Mobile Invitation Card -->
    <main class="w-full max-w-md min-h-screen bg-[#fffdf9] shadow-2xl overflow-hidden relative border-x border-[#f0e6d8] my-0 md:my-6 md:rounded-3xl">
        
        <!-- Hero Cover Section -->
        <section class="relative pt-12 pb-10 px-6 text-center border-b border-[#f3ebde]">
            <div class="mb-4">
                <span class="font-header text-3xl text-[#9c826b] tracking-widest">L & G</span>
            </div>
            <h1 class="font-header text-3xl text-[#5c4e3e] mb-2 tracking-wide">ლიზა & გიორგი</h1>
            <p class="text-xs text-[#a3907c] uppercase tracking-widest mb-6">17 ოქტომბერი, 2026</p>
            
            <!-- Cover Floral Graphic / Image 1 -->
            <div class="w-full h-64 rounded-2xl overflow-hidden shadow-md my-6 relative border border-[#ede3d5]">
                <img src="https://images.unsplash.com/photo-1519225421980-715cb0215aed?auto=format&fit=crop&w=800&q=80" alt="Wedding Cover" class="w-full h-full object-cover">
            </div>

            <p class="text-sm italic text-[#7a6b58] leading-relaxed max-w-xs mx-auto">
                "სიყვარული არ არის მხოლოდ ერთმანეთის ცქერა, ეს არის მზერა ერთი მიმართულებით."
            </p>
        </section>

        <!-- Countdown Timer Section -->
        <section class="py-10 px-6 text-center bg-[#fcf8f2] border-b border-[#f3ebde]">
            <h3 class="font-header text-lg text-[#6e5d4c] mb-6">დარჩენილი დრო</h3>
            <div id="countdown" class="grid grid-cols-4 gap-2 text-center max-w-xs mx-auto">
                <div class="bg-white p-3 rounded-xl border border-[#ece1d3] shadow-sm">
                    <span id="days" class="block font-header text-xl text-[#8a7157] font-semibold">00</span>
                    <span class="text-[10px] text-[#a89887] uppercase tracking-wider">დღე</span>
                </div>
                <div class="bg-white p-3 rounded-xl border border-[#ece1d3] shadow-sm">
                    <span id="hours" class="block font-header text-xl text-[#8a7157] font-semibold">00</span>
                    <span class="text-[10px] text-[#a89887] uppercase tracking-wider">საათი</span>
                </div>
                <div class="bg-white p-3 rounded-xl border border-[#ece1d3] shadow-sm">
                    <span id="minutes" class="block font-header text-xl text-[#8a7157] font-semibold">00</span>
                    <span class="text-[10px] text-[#a89887] uppercase tracking-wider">წუთი</span>
                </div>
                <div class="bg-white p-3 rounded-xl border border-[#ece1d3] shadow-sm">
                    <span id="seconds" class="block font-header text-xl text-[#8a7157] font-semibold">00</span>
                    <span class="text-[10px] text-[#a89887] uppercase tracking-wider">წამი</span>
                </div>
            </div>
        </section>

        <!-- Church Ceremony Section -->
        <section class="py-10 px-6 border-b border-[#f3ebde]">
            <div class="text-center mb-6">
                <!-- Image 2: Church Placeholder -->
                <div class="w-full h-48 rounded-2xl overflow-hidden shadow-sm mb-6 border border-[#ede3d5]">
                    <img src="https://images.unsplash.com/photo-1548625361-18081f33f95b?auto=format&fit=crop&w=800&q=80" alt="Church Ceremony" class="w-full h-full object-cover">
                </div>
                <h3 class="font-header text-xl text-[#5c4e3e] mb-2">საეკლესიო ცერემონია</h3>
                <p class="text-sm font-semibold text-[#8c7355] mb-1">15:30 საათი</p>
                <p class="text-sm text-[#6e5d4c]">მთაწმინდის წმ. ნინოს ტაძარი</p>
                <p class="text-xs text-[#a0907e] mt-1">9 Shota Chitadze St, Tbilisi</p>
            </div>
            <div class="text-center">
                <a href="https://maps.app.goo.gl/2LpKrZV7U8JbyY4d8" target="_blank" class="inline-block bg-[#8c7355] text-white text-xs px-6 py-3 rounded-full shadow-md hover:bg-[#735e44] transition-all">
                    რუკაზე ნახვა
                </a>
            </div>
        </section>

        <!-- Wedding Reception Section -->
        <section class="py-10 px-6 border-b border-[#f3ebde] bg-[#fcf8f2]">
            <div class="text-center mb-6">
                <!-- Image 3: Transparent background illustration placeholder -->
                <div class="w-full h-48 rounded-2xl overflow-hidden mb-6 flex items-center justify-center p-2">
                    <img src="https://images.unsplash.com/photo-1511795409834-ef04bbd61622?auto=format&fit=crop&w=800&q=80" alt="Wedding Party" class="max-h-full object-contain">
                </div>
                <h3 class="font-header text-xl text-[#5c4e3e] mb-2">საქორწილო წვეულება</h3>
                <p class="text-sm text-[#6e5d4c] font-medium">Hillside | ივენთ ჰოლი "ჰილსაიდი"</p>
                <p class="text-xs text-[#a0907e] mt-1 mb-6">Tbilisi-Kojori I Dead End, Tbilisi</p>
            </div>

            <!-- Schedule List -->
            <div class="space-y-4 max-w-xs mx-auto mb-8 text-sm">
                <div class="flex items-center justify-between border-b border-[#eaddca] pb-2">
                    <span class="font-semibold text-[#8c7355]">17:00</span>
                    <span class="text-[#5c4e3e]">მისასალმებელი კოქტეილი</span>
                </div>
                <div class="flex items-center justify-between border-b border-[#eaddca] pb-2">
                    <span class="font-semibold text-[#8c7355]">17:30</span>
                    <span class="text-[#5c4e3e]">ხელის მოწერის ცერემონია</span>
                </div>
                <div class="flex items-center justify-between border-b border-[#eaddca] pb-2">
                    <span class="font-semibold text-[#8c7355]">18:00</span>
                    <span class="text-[#5c4e3e]">საზეიმო ვახშამი</span>
                </div>
                <div class="flex items-center justify-between border-b border-[#eaddca] pb-2">
                    <span class="font-semibold text-[#8c7355]">20:00+</span>
                    <span class="text-[#5c4e3e]">წვეულება - გუგუნი დილამდე</span>
                </div>
            </div>

            <div class="text-center">
                <a href="https://maps.app.goo.gl/D95GpLyCcRzBArGfA" target="_blank" class="inline-block bg-[#8c7355] text-white text-xs px-6 py-3 rounded-full shadow-md hover:bg-[#735e44] transition-all">
                    რუკაზე ნახვა
                </a>
            </div>
        </section>

        <!-- RSVP Form Section -->
        <section class="py-10 px-6 border-b border-[#f3ebde]">
            <div class="text-center mb-6">
                <h3 class="font-header text-xl text-[#5c4e3e] mb-2">დასწრების დადასტურება</h3>
                <p class="text-xs text-[#a0907e]">გთხოვთ შეავსოთ ფორმა</p>
            </div>
            <form id="rsvpForm" onsubmit="handleRSVP(event)" class="space-y-4 max-w-xs mx-auto">
                <div>
                    <input type="text" id="guestName" required placeholder="თქვენი სახელი და გვარი" class="w-full text-sm px-4 py-3 rounded-xl border border-[#e2d5c3] bg-[#fffdfa] focus:outline-none focus:border-[#8c7355]">
                </div>
                <div>
                    <select id="attendance" required class="w-full text-sm px-4 py-3 rounded-xl border border-[#e2d5c3] bg-[#fffdfa] focus:outline-none focus:border-[#8c7355]">
                        <option value="" disabled selected>დაესწრებით ქორწილს?</option>
                        <option value="yes">სიამოვნებით დავესწრები</option>
                        <option value="no">სამწუხა���ოდ ვერ დავესწრები</option>
                    </select>
                </div>
                <button type="submit" class="w-full bg-[#8c7355] text-white text-xs font-medium py-3 rounded-xl shadow-md hover:bg-[#735e44] transition-all">
                    გაგზავნა
                </button>
            </form>
            <p id="rsvpMessage" class="hidden text-center text-xs text-[#735e44] mt-4 font-medium">გმადლობთ! თქვენი პასუხი მიღებულია.</p>
        </section>

        <!-- Final Message Footer -->
        <footer class="py-12 px-6 text-center bg-[#f7f2ea]">
            <p class="text-sm italic text-[#6e5d4c] mb-6 leading-relaxed">
                გვიხარია, რომ ამ განსაკუთრებულ და ბედნიერ დღეს ჩვენთან ერთად გაიზიარებთ!
            </p>
            <span class="font-header text-2xl text-[#8c7355] block mb-2">L & G</span>
            <p class="text-[10px] text-[#b0a090] tracking-widest uppercase">17.10.2026</p>
        </footer>

    </main>

    <!-- JavaScript Controls & Countdown -->
    <script>
        // Open Envelope
        function openInvitation() {
            document.getElementById('envelope').classList.add('envelope-open');
            playAudio();
        }

        // Audio Toggle
        const audio = document.getElementById('weddingMusic');
        const iconPlay = document.getElementById('musicIconPlay');
        const iconMute = document.getElementById('musicIconMute');
        let isPlaying = false;

        function playAudio() {
            audio.play().then(() => {
                isPlaying = true;
                iconPlay.classList.remove('hidden');
                iconMute.classList.add('hidden');
            }).catch(e => {
                console.log("Autoplay blocked or audio load error");
            });
        }

        function toggleAudio() {
            if (isPlaying) {
                audio.pause();
                isPlaying = false;
                iconPlay.classList.add('hidden');
                iconMute.classList.remove('hidden');
            } else {
                playAudio();
            }
        }

        // Countdown Timer to Oct 17, 2026 15:30
        const weddingDate = new Date("October 17, 2026 15:30:00").getTime();

        function updateCountdown() {
            const now = new Date().getTime();
            const distance = weddingDate - now;

            if (distance > 0) {
                const days = Math.floor(distance / (1000 * 60 * 60 * 24));
                const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
                const seconds = Math.floor((distance % (1000 * 60)) / 1000);

                document.getElementById('days').innerText = String(days).padStart(2, '0');
                document.getElementById('hours').innerText = String(hours).padStart(2, '0');
                document.getElementById('minutes').innerText = String(minutes).padStart(2, '0');
                document.getElementById('seconds').innerText = String(seconds).padStart(2, '0');
            } else {
                document.getElementById('countdown').innerHTML = '<div class="col-span-4 text-[#8c7355] font-semibold">დღეს ქორწილის დღეა!</div>';
            }
        }

        setInterval(updateCountdown, 1000);
        updateCountdown();

        // RSVP Form Handler
        function handleRSVP(event) {
            event.preventDefault();
            document.getElementById('rsvpForm').classList.add('hidden');
            document.getElementById('rsvpMessage').classList.remove('hidden');
            // Here you can add code to send the form data to your backend
        }
    </script>
</body>
</html>
